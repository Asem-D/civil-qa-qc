<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CivilQc.Rules</RootNamespace>
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CivilQc.Engine\CivilQc.Engine.csproj" />
  </ItemGroup>

  <!-- AutoCAD API references â€” only base AutoCAD, not Civil 3D.
       Current rules use DatabaseServices (layers, xrefs, entities) which
       live in acdbmgd.dll and accoremgd.dll. Civil 3D-specific rules
       (future) will need AeccDbMgd/AeccCoreMgd added here. -->
  <PropertyGroup>
    <AutoCADInstallDir Condition="'$(AutoCADInstallDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2025</AutoCADInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="acdbmgd">
      <HintPath>$(AutoCADInstallDir)\acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="accoremgd">
      <HintPath>$(AutoCADInstallDir)\accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- acmgd.dll provides ApplicationServices.Application (GetSystemVariable, DocumentManager, etc.) -->
    <Reference Include="acmgd">
      <HintPath>$(AutoCADInstallDir)\acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
